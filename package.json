{
  "name": "floatplane-queue-wxt",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-browser extension that adds video queueing functionality to Floatplane",
  "license": "GPL-3.0-or-later",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:edge": "wxt zip -b edge",
    "postinstall": "wxt prepare",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write . --ignore-path .oxfmtignore",
    "format:check": "oxfmt --check . --ignore-path .oxfmtignore",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.89.0",
    "@types/chrome": "^0.3.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "wxt": "^0.21.4"
  },
  "packageManager": "bun@1.4.3"
}
