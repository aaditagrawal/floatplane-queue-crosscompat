{
  "name": "floatplane-queue-wxt",
  "version": "1.0.0",
  "description": "Cross-browser extension that adds video queueing functionality to Floatplane",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:edge": "wxt zip -b edge",
    "postinstall": "wxt prepare",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write \"**/*.{js,mjs,cjs,ts,tsx,jsx}\" --ignore-path .gitignore --ignore-path .oxfmtignore --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check \"**/*.{js,mjs,cjs,ts,tsx,jsx}\" --ignore-path .gitignore --ignore-path .oxfmtignore --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.85.0",
    "@types/chrome": "^0.3.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  },
  "license": "GPL-3.0-or-later",
  "author": "",
  "packageManager": "bun@1.4.2"
}
